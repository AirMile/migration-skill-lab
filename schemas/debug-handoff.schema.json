{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.invalid/migration-skill-lab/debug-handoff.schema.json",
  "title": "Migration Debug Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "skill",
    "skillVersion",
    "runId",
    "flowId",
    "status",
    "flowContract",
    "migrationResult",
    "verificationResult",
    "failures",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "artifactType": { "const": "debug-handoff" },
    "skill": { "const": "verify-flow" },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["repairable", "external-blocked"]
    },
    "flowContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "migrationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expected",
          "actual",
          "evidence",
          "reproduction",
          "suspectedBoundary",
          "candidatePaths",
          "recommendedStartTier",
          "recommendationReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "enum": [
              "scenario",
              "validation",
              "manual-validation",
              "visual-parity"
            ]
          },
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "visualParityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reproduction": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "suspectedBoundary": { "type": "string", "minLength": 1 },
          "candidatePaths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "recommendedStartTier": {
            "type": "string",
            "enum": ["immediate", "light", "heavy"]
          },
          "recommendationReason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}

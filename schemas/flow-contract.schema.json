{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.invalid/migration-skill-lab/flow-contract.schema.json",
  "title": "Migration Flow Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "skill",
    "skillVersion",
    "runId",
    "flowId",
    "repository",
    "scope",
    "scenarios",
    "testGaps",
    "openQuestions",
    "checkpointPolicy",
    "validationPlan",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "enum": [3, 4, 5, 6, 7, 8] },
    "artifactType": { "const": "flow-contract" },
    "skill": { "const": "flow-baseline" },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "rejected"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "baselineReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "planSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "flowId", "remainder"],
      "properties": {
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "runId"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "flowId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "remainder": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startState",
        "endState",
        "allowedWritePaths"
      ],
      "properties": {
        "startState": { "type": "string", "minLength": 1 },
        "endState": { "type": "string", "minLength": 1 },
        "includedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedWritePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "partialMount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nested"],
          "properties": {
            "nested": { "type": "boolean" },
            "retainedParent": { "type": "string", "minLength": 1 },
            "siblingSections": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "visualParity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "counterpart", "appearance", "layout"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "surface": { "type": "string", "minLength": 1 },
          "counterpart": { "type": "string", "minLength": 1 },
          "appearance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "layout": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reference": { "type": "string", "minLength": 1 },
          "styleSources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sharedComponents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "renderedSurfaceInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "surface": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["migrate", "retain-react", "excluded"]
          },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targetArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "adapter", "lifecycle", "styling"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["proposed", "approved"]
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["angularOwns", "reactRetains"],
          "properties": {
            "angularOwns": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "reactRetains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "commands", "events", "nonSuccessOutcome"],
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "nonSuccessOutcome": { "type": "string", "minLength": 1 },
            "forbiddenAccess": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "styling": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencyChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "packages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:@[^@/]+/)?[^@/]+@[^@]+$"
              }
            },
            "paths": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "characterizationRequired": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypothesis", "proveBefore"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "hypothesis": { "type": "string", "minLength": 1 },
          "proveBefore": { "type": ["string", "array"] },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "decision"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "followUp": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testGaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "approvedByRole": { "type": "string", "minLength": 1 },
        "approvedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approvedDecisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "userStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "userValue",
        "currentBehavior",
        "desiredBehavior"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "userValue": { "type": "string", "minLength": 1 },
        "currentBehavior": { "type": "string", "minLength": 1 },
        "desiredBehavior": { "type": "string", "minLength": 1 }
      }
    },
    "workItemContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "epicExternalId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "featureExternalId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "storyExternalIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    },
    "checkpointPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "pushPolicy"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto-local", "disabled"]
        },
        "expectedBranch": {
          "type": "string",
          "minLength": 1
        },
        "externalRef": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]+$"
        },
        "authorizedByRole": {
          "type": "string",
          "minLength": 1
        },
        "authorizedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "pushPolicy": {
          "type": "string",
          "enum": ["confirm-after-pass", "never"]
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "validationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testCommands",
        "browserValidation",
        "manualValidation"
      ],
      "properties": {
        "testCommands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "installCommand": { "type": "string", "minLength": 1 },
        "typecheckCommand": { "type": "string", "minLength": 1 },
        "buildCommand": { "type": "string", "minLength": 1 },
        "browserValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "scenarios"],
          "properties": {
            "required": { "type": "boolean" },
            "owner": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "scenarios": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "manualValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "owner": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "scenario": { "type": "string", "minLength": 1 },
            "userPath": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
